# PostgreSQL Verbindung
DATABASE_URL=postgresql://dns_admin:changeme@postgres:5432/dns_server

# Zufälliger, langer geheimer Wert für Session-Cookies (z.B. `openssl rand -hex 32`)
SESSION_SECRET=change-this-to-a-long-random-string

NODE_ENV=production

# Wird nur verwendet, wenn noch kein Admin-User in der Datenbank existiert.
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=changeme

# DNS
DNS_UDP_PORT=53
DNS_TCP_PORT=53
DNS_BIND_ADDRESS=0.0.0.0
DNS_UPSTREAM_SERVERS=1.1.1.1,8.8.8.8
DNS_FORWARD_TIMEOUT_MS=4000

# DHCP
DHCP_ENABLED=true
DHCP_SERVER_PORT=67
DHCP_BIND_ADDRESS=0.0.0.0

# Web-Admin API
API_PORT=3000

# Nur für docker-compose.yml (Postgres-Container)
POSTGRES_USER=dns_admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=dns_server
